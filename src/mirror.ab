import { ensure_directory, error, file_exists, lock_file, real_path, write_file } from "io.ab"

fun hash_file(path: Text): Text {
    if not file_exists(path) { return "missing" }
    $ test -f "{path}" && test ! -L "{path}" $ failed { return "invalid" }
    const resolved = silent real_path(path) failed { return "invalid" }
    if path != resolved { return "invalid" }
    const hash = $ /usr/bin/shasum -a 256 < "{path}" | /usr/bin/awk 'NF == 2 && length(\$1) == 64 \{print \$1}' $ failed { return "invalid" }
    if hash == "" { return "invalid" }
    return hash
}

pub fun lock_sync_writes(state: Text) {
    ensure_directory(state)
    const path = "{state}/.write.lock"
    $ test ! -L "{path}" && exec 7>>"{path}" && /usr/bin/lockf -t 15 7 $ failed {
        error("Could not acquire the file write lock: {path}")
    }
}

fun running(directory: Text): Bool {
    $ /usr/bin/lockf -k -s -t 0 "{directory}/worker.lock" /usr/bin/true $ failed {
        if status() == 75 { return true }
        error("Could not check mirror worker: {directory}")
    }
    return false
}

fun load_session(path: Text): Text {
    if not file_exists(path) { return "\{\"pairs\":[]}" }
    $ test -f "{path}" && test ! -L "{path}" $ failed { error("Invalid mirror record: {path}") }
    const value = $ /usr/bin/jq -ces '
        select(length == 1) | .[0] | select(type == "object" and (.destination | type == "string")
        and (.writeBack | type == "boolean") and (.pairs | type == "array" and all(.[];
          (.source | type == "string" and startswith("/")) and (.copy | type == "string" and startswith("/"))
          and (.baseline == null or (.baseline | type == "string" and length == 64 and test("^[a-f0-9]+\$"))))))
    ' -- "{path}" $ failed { error("Invalid mirror record: {path}") }
    return value
}

fun directory_is_safe(path: Text): Bool {
    const resolved = suppress $ /bin/realpath -- "{path}" $ failed {
        if file_exists(path) { return false }
        const parent = $ /usr/bin/dirname -- "{path}" $ failed { return false }
        if parent == path { return false }
        return directory_is_safe(parent)
    }
    return resolved == path
}

fun copy_checked(state: Text, source: Text, source_hash: Text, target: Text, target_hash: Text, backup_target: Bool): Bool {
    const parent = $ /usr/bin/dirname -- "{target}" $ failed { return false }
    if not directory_is_safe(parent) { return false }
    $ /bin/mkdir -p -- "{parent}" $ failed { return false }
    if not directory_is_safe(parent) { return false }
    const temp = $ /usr/bin/mktemp "{parent}/.file-sync.XXXXXX" $ failed { return false }
    $ /bin/cp -p -- "{source}" "{temp}" $ failed {
        trust $ /bin/rm -f -- "{temp}" $
        return false
    }
    if hash_file(temp) != source_hash or hash_file(target) != target_hash or not directory_is_safe(parent) {
        trust $ /bin/rm -f -- "{temp}" $
        return false
    }
    if backup_target {
        $ /bin/mkdir -p -- "{state}/backup" && /bin/chmod 700 "{state}/backup" $ failed {
            trust $ /bin/rm -f -- "{temp}" $
            return false
        }
        const backup = $ /usr/bin/mktemp "{state}/backup/mirror.XXXXXX" $ failed {
            trust $ /bin/rm -f -- "{temp}" $
            return false
        }
        $ /bin/cp -- "{target}" "{backup}" $ failed {
            trust $ /bin/rm -f -- "{temp}" "{backup}" $
            return false
        }
    }
    $ /bin/mv -f -h -- "{temp}" "{target}" $ failed {
        trust $ /bin/rm -f -- "{temp}" $
        return false
    }
    return true
}

fun mirror_change(source: Text, copy: Text, previous: Text, write_back: Bool): Text {
    if source == "invalid" or copy == "invalid" { return "unreadable or replaced path" }
    if source == "missing" { return "missing source" }
    if copy == source { return "equal" }
    if copy == "missing" or (previous != "" and copy == previous) { return "copy" }
    if source == previous and write_back { return "write-back" }
    if source == previous { return "copy edited" }
    return "conflict"
}

fun reconcile_pair(state: Text, pair: Text, write_back: Bool): Text {
    const source = $ /usr/bin/jq -er '.source' <<< "{pair}" $ failed { error("Invalid mirror source") }
    const copy = $ /usr/bin/jq -er '.copy' <<< "{pair}" $ failed { error("Invalid mirror copy") }
    const previous = $ /usr/bin/jq -r '.baseline // ""' <<< "{pair}" $ failed { error("Invalid mirror baseline") }
    const source_hash = hash_file(source)
    const copy_hash = hash_file(copy)
    const action = mirror_change(source_hash, copy_hash, previous, write_back)
    let next = previous
    let problem = action
    if action == "equal" {
        next = source_hash
        problem = ""
    }
    if action == "copy" {
        if copy_checked(state, source, source_hash, copy, copy_hash, false) {
            next = source_hash
            problem = ""
        } else {
            problem = "copy changed or could not be written"
        }
    }
    if action == "write-back" {
        if copy_checked(state, copy, copy_hash, source, source_hash, true) {
            next = copy_hash
            problem = ""
        } else {
            problem = "source changed or could not be written"
        }
    }
    const update = $ /usr/bin/jq -c --arg baseline "{next}" --arg problem "{problem}" '
        .baseline = (if \$baseline == "" then null else \$baseline end)
        | .problem = (if \$problem == "" then null else \$problem end)
    ' <<< "{pair}" $ failed { error("Could not update mirror pair") }
    return update
}

fun reconcile_mirror(state: Text, directory: Text, destination: Text, session: Text) {
    const file = "{directory}/session.json"
    const count = $ /usr/bin/jq -r '.pairs | length' <<< "{session}" $ failed { error("Could not count files") }
    let next_session = session
    const direction = $ /usr/bin/jq -r '.writeBack' <<< "{session}" $ failed { error("Could not read mirror direction") }
    let index = 0
    loop {
        $ test "{index}" -lt "{count}" $ failed { break }
        if file_exists("{directory}/stop") { break }
        if not directory_is_safe(destination) { break }
        const pair = $ /usr/bin/jq -c --argjson index "{index}" '.pairs[\$index]' <<< "{next_session}" $ failed { error("Could not read mirror pair") }
        const copy = $ /usr/bin/jq -er '.copy' <<< "{pair}" $ failed { error("Invalid mirror copy") }
        $ [[ "{copy}" == "{destination}/"* ]] $ failed { error("Mirror copy is outside the destination") }
        lock_sync_writes(state)
        const updated = reconcile_pair(state, pair, direction == "true")
        trust $ exec 7>&- $
        next_session = $ printf '%s\n' "{next_session}" "{updated}" | /usr/bin/jq -cs --argjson index "{index}" '
            .[1] as \$pair | .[0] | .pairs[\$index] = \$pair
        ' $ failed { error("Could not update mirror record") }
        index += 1
    }
    if next_session != session { write_file(file, next_session) }
}

pub fun mirror_worker(state: Text, directory: Text, destination: Text) {
    const worker_lock = "{directory}/worker.lock"
    $ test ! -L "{worker_lock}" && exec 8>>"{worker_lock}" && /usr/bin/lockf -s -t 0 8 $ failed { exit(1) }
    loop {
        if file_exists("{directory}/stop") { exit(0) }
        $ test -d "{destination}" $ failed { exit(0) }
        if not directory_is_safe(destination) { exit(1) }
        const session = load_session("{directory}/session.json")
        reconcile_mirror(state, directory, destination, session)
        trust $ /bin/sleep 1 $
    }
}

fun mirror_destination(input: Text, start: Bool): Text {
    const existing = suppress $ /bin/realpath -- "{input}" $ failed {
        if start { ensure_directory(input) }
        const parent = $ /usr/bin/dirname -- "{input}" $ failed { error("Invalid mirror destination") }
        const base = $ /usr/bin/basename -- "{input}" $ failed { error("Invalid mirror destination") }
        const resolved = real_path(parent) failed { error("Invalid mirror destination: {input}") }
        return "{resolved}/{base}"
    }
    return existing
}

pub fun mirror_command(state: Text, args: [Text]) {
    let path = ""
    let action = "start"
    let write_back = false
    let inputs = []
    let index = 2
    while index < len(args) {
        const flag = args[index]
        index += 1
        if flag == "--to" {
            if path != "" or index >= len(args) { error("Specify one --to <directory>", 2) }
            path = args[index]
            index += 1
            continue
        }
        if flag == "--stop" or flag == "--status" {
            if action != "start" { error("Use one mirror operation", 2) }
            action = flag
            continue
        }
        if flag == "--write-back" {
            write_back = true
            continue
        }
        if flag == "--" {
            while index < len(args) {
                inputs += [args[index]]
                index += 1
            }
            break
        }
        error("Unknown mirror option: {flag}", 2)
    }
    if path == "" or (action == "start" and len(inputs) == 0) or (action != "start" and (len(inputs) != 0 or write_back)) {
        error("Usage: file-sync.sh mirror --to <directory> [--write-back] -- <file>... | mirror --to <directory> --status|--stop", 2)
    }
    const destination = mirror_destination(path, action == "start")
    if destination == "/" { error("Choose a mirror directory below /", 2) }
    const key = $ printf '%s' "{destination}" | /usr/bin/shasum -a 256 | /usr/bin/awk '\{print \$1}' $ failed { error("Could not identify mirror destination") }
    if key == "" { error("Could not identify mirror destination") }
    const directory = "{state}/mirror/{key}"
    if action == "start" { ensure_directory(directory) }
    $ test -d "{directory}" && test ! -L "{directory}" $ failed { error("No mirror for: {destination}") }
    lock_file("{directory}/control.lock")
    const session = load_session("{directory}/session.json")
    const is_running = running(directory)
    if action == "--status" {
        $ /usr/bin/jq -c --argjson running "{is_running}" '. + \{running: (\$running == 1)}' <<< "{session}" $ failed { error("Could not show mirror state") }
        if not is_running { exit(1) }
        exit(0)
    }
    if action == "--stop" {
        if is_running {
            $ : > "{directory}/stop" $ failed { error("Could not request mirror stop") }
            for _attempt in 0..50 {
                if not running(directory) { exit(0) }
                trust $ /bin/sleep 0.1 $
            }
            error("Mirror is still stopping: {destination}")
        }
        exit(0)
    }

    let sources = []
    for input in inputs {
        const source = real_path(input) failed { error("File not found: {input}") }
        $ test -f "{source}" && [[ "{source}" != "{destination}/"* ]] $ failed { error("Invalid mirror source: {source}") }
        sources += [source]
    }
    const requested = $ /usr/bin/jq -nc --arg dst "{destination}" --argjson back "{write_back}" '
        \{destination:\$dst,writeBack:(\$back == 1),pairs:(\$ARGS.positional | unique | map(\{source:.,copy:(\$dst + .),baseline:null}))}
    ' --args -- "{sources}" $ failed { error("Could not encode mirror paths") }
    if is_running {
        $ printf '%s\n' "{requested}" "{session}" | /usr/bin/jq -es '
            def settings: del(.pairs[].baseline,.pairs[].problem);
            (.[0] | settings) == (.[1] | settings)
        ' >/dev/null $ failed { error("Stop the current mirror before changing its settings") }
        echo(destination)
        exit(0)
    }
    const pending = $ printf '%s\n' "{requested}" "{session}" | /usr/bin/jq -cs '
        .[1].pairs as \$old | .[0] | .pairs |= map(. as \$p |
        .baseline = ([\$old[] | select(.source == \$p.source and .copy == \$p.copy) | .baseline] | last))
    ' $ failed { error("Could not restore mirror baseline") }
    const count = $ /usr/bin/jq -r '.pairs | length' <<< "{pending}" $ failed { error("Could not count files") }
    let pair_index = 0
    loop {
        $ test "{pair_index}" -lt "{count}" $ failed { break }
        const pair = $ /usr/bin/jq -c --argjson i "{pair_index}" '.pairs[\$i]' <<< "{pending}" $ failed { error("Invalid mirror pair") }
        const source = $ /usr/bin/jq -er '.source' <<< "{pair}" $ failed { error("Invalid mirror source") }
        const copy = $ /usr/bin/jq -er '.copy' <<< "{pair}" $ failed { error("Invalid mirror copy") }
        const previous = $ /usr/bin/jq -r '.baseline // ""' <<< "{pair}" $ failed { error("Invalid mirror baseline") }
        const copy_hash = hash_file(copy)
        if copy_hash == "invalid" or (copy_hash != "missing" and previous == "" and copy_hash != hash_file(source)) {
            error("Existing copy differs; mirror was not started: {copy}")
        }
        pair_index += 1
    }
    trust $ /bin/rm -f -- "{directory}/stop" $
    write_file("{directory}/session.json", pending)
    reconcile_mirror(state, directory, destination, pending)
    const script = real_path(args[0]) failed { error("Could not locate file-sync.sh") }
    trust $ (exec 9>&-; exec /usr/bin/nohup /bin/bash "{script}" --mirror-worker "{directory}" "{destination}") </dev/null >>"{directory}/worker.log" 2>&1 & $
    for _attempt in 0..50 {
        if running(directory) {
            echo(destination)
            exit(0)
        }
        trust $ /bin/sleep 0.1 $
    }
    error("Mirror worker did not start: {directory}/worker.log")
}
